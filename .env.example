# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Google Identity Services web client; no client secret is required for this flow.
GOOGLE_CLIENT_ID=
# Engineering text chat (paid entitlement required). Choose a model enabled on your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
