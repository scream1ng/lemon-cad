DATABASE_URL=postgresql+psycopg://lemon:lemon@127.0.0.1:55438/lemoncad
APP_ORIGIN=http://127.0.0.1:5178
COOKIE_SECURE=false
STORAGE_DIR=.data/objects
JOB_TIMEOUT_SECONDS=180
